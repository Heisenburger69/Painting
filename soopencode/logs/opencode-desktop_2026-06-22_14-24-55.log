rice;\n1736:         padding: 0;\n1737:         border: none;\n1738:         font-size: 11px;\n1739:         color: var(--slate-gray);\n1740:     }\n1741: \n1742:     .artworks-table td:nth-child(8) { /* Featured */\n1743:         grid-area: feat;\n1744:         padding: 0;\n1745:         border: none;\n1746:         justify-self: end;\n1747:         display: inline-flex;\n1748:         align-items: center;\n1749:         gap: 4px;\n1750:     }\n1751: \n1752:     .artworks-table td:nth-child(8) input[type=\"checkbox\"] {\n1753:         width: 20px;\n1754:         height: 20px;\n1755:         cursor: pointer;\n1756:     }\n1757: \n1758:     .artworks-table td:nth-child(9) { /* On Sale */\n1759:         grid-area: onsale;\n1760:         padding: 0;\n1761:         border: none;\n1762:         justify-self: end;\n1763:         display: inline-flex;\n1764:         align-items: center;\n1765:         gap: 4px;\n1766:     }\n1767: \n1768:     .artworks-table td:nth-child(9) input[type=\"checkbox\"] {\n1769:         width: 20px;\n1770:         height: 20px;\n1771:         cursor: pointer;\n1772:     }\n1773: \n1774:     /* ═══════════════════════════════════════════\n1775:        Row 4: Drag(col 1) | Edit(col 3) | Delete(col 5)\n1776:        ═══════════════════════════════════════════ */\n1777: \n1778:     .artworks-table td:first-child:not([colspan]) { /* Drag handle */\n1779:         grid-area: drag;\n1780:         padding: 0;\n1781:         border: none;\n1782:         display: flex;\n1783:         align-items: center;\n1784:         gap: 2px;\n1785:         white-space: nowrap;\n1786:     }\n1787: \n1788:     .artworks-table td:first-child:not([colspan]) span {\n1789:         font-size: 18px;\n1790:         color: #888;\n1791:     }\n1792: \n1793:     .artworks-table td:first-child:not([colspan]) button {\n1794:         font-size: 12px !important;\n1795:         padding: 2px 6px !important;\n1796:         border: 1px solid #ddd !important;\n1797:         border-radius: 