{"role":"tool","tool_call_id":"call_00_ZPAsjdCH2QktAdJ1wnWB9309","content":"<path>C:\\Users\\Joe\\Downloads\\Magazine_prototype_backup\\app\\admin\\page.js</path>\n<type>file</type>\n<content>\n1: 'use client'\n2: \n3: import { useState, useEffect, useRef, Fragment } from 'react'\n4: import { useRouter } from 'next/navigation'\n5: import { getBrowserSupabase, getServiceSupabase } from '@/lib/supabase'\n6: import { getAdminClient } from '@/lib/admin-client'\n7: import { ON_SALE_COLLECTION_ID } from '@/lib/db'\n8: \n9: const TABS = ['Artworks', 'Collections', 'Profile', 'Exhibitions', 'Events', 'Orders']\n10: \n11: export default function AdminPage() {\n12:   const [tab, setTab] = useState('Artworks')\n13:   const [error, setError] = useState('')\n14:   const [success, setSuccess] = useState('')\n15:   const router = useRouter()\n16: \n17:   const handleLogout = async () => {\n18:     const supabase = getBrowserSupabase()\n19:     if (supabase) await supabase.auth.signOut()\n20:     router.push('/')\n21:   }\n22: \n23:   return (\n24:     <main className=\"main-content\" style={{ paddingTop: 100 }}>\n25:       <div className=\"container\">\n26:         <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', marginBottom: 30 }}>\n27:           <h2 style={{ margin: 0 }}>Admin Dashboard</h2>\n28:           <button onClick={handleLogout} style={{ padding: '6px 16px', border: '1px solid var(--slate-gray)', borderRadius: 6, background: 'transparent', color: 'var(--slate-gray)', fontSize: 12, fontWeight: 600, cursor: 'pointer' }}>Log Out</button>\n29:         </div>\n30: \n31:         {error && <div style={{ background: '#fef2f2', color: '#b91c1c', padding: '10px 16px', borderRadius: 8, marginBottom: 20, fontSize: 14 }}>{error}</div>}\n32:         {success && <div style={{ background: '#f0fdf4', color: '#166534', padding: '10px 16px', borderRadius: 8, marginBottom: 20, fontSize: 14 }}>{success}</div>}\n33: \n34:         <div style={{ display: 'flex', gap: 8, marginBottom: 30, flexWrap: 'wrap', borderBottom: '1px solid var(--border)', paddingBottom: 12 }}>\n35:           {TABS.map((t) => (\n36:             <button key={t} onClick={() => { setTab(t); setError(''); setSuccess('') }}\n37:               style={{ padding: '8px 20px', border: 'none', borderRadius: 6, cursor: 'pointer', fontWeight: 600, fontSize: 13, background: tab === t ? 'var(--coffee)' : 'transparent', color: tab === t ? '#fff' : 'var(--slate-gray)' }}>\n38:               {t}\n39:             </button>\n40:           ))}\n41:         </div>\n42: \n43:         {tab === 'Artworks' && <ArtworksManager setError={setError} setSuccess={setSuccess} />}\n44:         {tab === 'Collections' && <CollectionsManager setError={setError} setSuccess={setSuccess} />}\n45:         {tab === 'Profile' && <ProfileManager setError={setError} setSuccess={setSuccess} />}\n46:         {tab === 'Exhibitions' && <ExhibitionsManager setError={setError} setSuccess={setSuccess} />}\n47:         {tab === 'Events' && <EventsManager setError={setError} setSuccess={setSuccess} />}\n48:         {tab === 'Orders' && <OrdersManager setError={setError} setSuccess={setSuccess} />}\n49:       </div>\n50:     </main>\n51:   )\n52: }\n53: \n54: /* ─── Artworks ─── */\n55: function ArtworksManager({ setError, setSuccess }) {\n56:   const [grouped, setGrouped] = useState([])\n57:   const [uncollected, setUncollected] = useState([])\n58:   const [collections, setCollections] = useState([])\n59:   const [onSaleArts, setOnSaleArts] = useState([])\n60:   const [edit, setEdit] = useState(null)\n61:   const [busy, setBusy] = useState(false)\n62:   const [dirty, setDirty] = useState(false)\n63:   const dragSrc = useRef(null)\n64: \n65:   const load = async () => {\n66:     try {\n67:       const supabase = await getAdminClient()\n68:       const [arts, colls] = await Promise.all([\n69:         supabase.from('artworks').select('*, artwork_images(*)').is('deleted_at', null).order('sort_order', { ascending: true }),\n70:         supabase.from('collections').select('*').order('sort_order', { ascending: true }),\n71:       ])\n72:       if (arts.error) throw arts.error\n73:       if (colls.error) throw colls.error\n74: \n75:       const sortedColls = [...(colls.data || [])].sort((a, b) => a.sort_order - b.sort_order)\n76:       const allArts = arts.data || []\n77: \n78:       const grp = sortedColls.map((c) => ({\n79:         collection: c,\n80:         artworks: allArts.filter((a) => a.collection_id === c.id).sort((a, b) => a.sort_order - b.sort_order),\n81:       }))\n82:       const unc = allArts.filter((a) => !a.collection_id).sort((a, b) => a.sort_order - b.sort_order)\n83: \n84:       const onSaleArts = allArts.filter((a) => a.is_on_sale).sort((a, b) => (a.on_sale_sort_order ?? 0) - (b.on_sale_sort_order ?? 0))\n85:       setOnSaleArts(onSaleArts)\n86:       setGrouped(grp)\n87:       setUncollected(unc)\n88:       setCollections(sortedColls)\n89:       setDirty(false)\n90:     } catch (e) { setError(e.message) }\n91:   }\n92:   useEffect(() => { load() }, [])\n93: \n94:   /* ── local reorder helpers (no DB save) ── */\n95:   const moveUp = (items, idx) => {\n96:     if (idx <= 0) return items\n97:     const next = [...items]\n98:     ;[next[idx - 1], next[idx]] = [next[idx], next[idx - 1]]\n99:     return next\n100:   }\n101:   const moveDown = (items, idx) => {\n102:     if (idx >= items.length - 1) return items\n103:     const next = [...items]\n104:     ;[next[idx], next[idx + 1]] = [next[idx + 1], next[idx]]\n105:     return next\n106:   }\n107: \n108:   /* ── drag-and-drop ── */\n109:   const handleDragStart = (e, groupId, index, isUncollected) => {\n110:     dragSrc.current = { groupId, index, isUncollected }\n111:     e.dataTransfer.effectAllowed = 'move'\n112:     e.dataTransfer.setData('text/plain', '')\n113:   }\n114:   const handleDragOver = (e) => { e.preventDefault(); e.dataTransfer.dropEffect = 'move' }\n115:   const handleDrop = (e, targetGroupId, targetIndex, targetIsUncollected) => {\n116:     e.preventDefault()\n117:     const src = dragSrc.current\n118:     dragSrc.current = null\n119:     if (!src) return\n120:     if (src.groupId !== targetGroupId || src.isUncollected !== targetIsUncollected) return\n121:     if (src.index === targetIndex) return\n122: \n123:     if (src.isUncollected) {\n124:       setUncollected(prev => {\n125:         const next = [...prev]\n126:         const [moved] = next.splice(src.index, 1)\n127:         next.splice(targetIndex, 0, moved)\n128:         return next\n129:       })\n130:     } else if (src.groupId === 'on-sale') {\n131:       setOnSaleArts(prev => {\n132:         const next = [...prev]\n133:         const [moved] = next.splice(src.index, 1)\n134:         next.splice(targetIndex, 0, moved)\n135:         return next\n136:       })\n137:     } else {\n138:       setGrouped(prev => prev.map(g => {\n139:         if (g.collection.id !== src.groupId) return g\n140:         const artworks = [...g.artworks]\n141:         const [moved] = artworks.splice(src.index, 1)\n142:         artworks.splice(targetIndex, 0, moved)\n143:         return { ...g, artworks }\n144:       }))\n145:     }\n146:     setDirty(true)\n147:   }\n148: \n149:   /* ── local arrow reorder ── */\n150:   const arrowUp = (groupId, index, isUncollected) => {\n151:     if (isUncollected) {\n152:       setUncollected(prev => moveUp(prev, index))\n153:     } else if (groupId === 'on-sale') {\n154:       setOnSaleArts(prev => moveUp(prev, index))\n155:     } else {\n156:       setGrouped(prev => prev.map(g => {\n157:         if (g.collection.id !== groupId) return g\n158:         return { ...g, artworks: moveUp(g.artworks, index) }\n159:       }))\n160:     }\n161:     setDirty(true)\n162:   }\n163:   const arrowDown = (groupId, index, isUncollected) => {\n164:     if (isUncollected) {\n165:       setUncollected(prev => moveDown(prev, index))\n166:     } else if (groupId === 'on-sale') {\n167:       setOnSaleArts(prev => moveDown(prev, index))\n168:     } else {\n169:       setGrouped(prev => prev.map(g => {\n170:         if (g.collection.id !== groupId) return g\n171:         return { ...g, artworks: moveDown(g.artworks, index) }\n172:       }))\n173:     }\n174:     setDirty(true)\n175:   }\n176: \n177:   /* ── batch save order ── */\n178:   const saveOrder = async () => {\n179:     setBusy(true)\n180:     try {\n181:       const supabase = await getAdminClient()\n182:       const updates = []\n183:       for (const g of grouped) {\n184:         g.artworks.forEach((a, i) => updates.push(supabase.from('artworks').update({ sort_order: i }).eq('id', a.id)))\n185:       }\n186:       uncollected.forEach((a, i) => updates.push(supabase.from('artworks').update({ sort_order: i }).eq('id', a.id)))\n187:       onSaleArts.forEach((a, i) => updates.push(supabase.from('artworks').update({ on_sale_sort_order: i }).eq('id', a.id)))\n188:       await Promise.all(updates)\n189:       setSuccess('Order saved!')\n190:       setDirty(false)\n191:     } catch (e) { setError(e.message) }\n192:     setBusy(false)\n193:   }\n194: \n195:   const handleSave = async (form) => {\n196:     setBusy(true); setError(''); setSuccess('')\n197:     try {\n198:       const supabase = await getAdminClient()\n199:       const artworkId = form.id || (crypto.randomUUID?.() || 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, (c) => { const r = Math.random() * 16 | 0; return (c === 'x' ? r : (r & 0x3) | 0x8).toString(16) }))\n200:       const payload = {\n201:         id: artworkId, title: form.title, year: form.year, medium: form.medium,\n202:         width_cm: form.width_cm || null, height_cm: form.height_cm || null, depth_cm: form.depth_cm || null, weight_kg: form.weight_kg || null,\n203:         description: form.description, price: form.price || 0,\n204:         status: form.status || 'available',\n205:         is_featured: form.is_featured || false, is_on_sale: form.is_on_sale || false,\n206:         is_published: form.is_published !== undefined ? form.is_published : true,\n207:         sort_order: form.sort_order || 0, collection_id: form.collection_id || null,\n208:       }\n209:       const { error } = await supabase.from('artworks').upsert(payload)\n210:       if (error) throw error\n211: \n212:       if (form.files && form.files.length > 0) {\n213:         const { count } = await supabase.from('artwork_images').select('*', { count: 'exact', head: true }).eq('artwork_id', artworkId)\n214:         for (let i = 0; i < form.files.length; i++) {\n215:           const file = form.files[i]\n216:           const ext = file.name.split('.').pop()\n217:           const filePath = `artwork_${Date.now()}_${Math.random().toString(36).slice(2, 6)}.${ext}`\n218:           const { error: uploadErr } = await supabase.storage.from('artworks').upload(filePath, file, { contentType: file.type })\n219:           if (uploadErr) throw uploadErr\n220:           const { data: { publicUrl } } = supabase.storage.from('artworks').getPublicUrl(filePath)\n221:           const { error: insertErr } = await supabase.from('artwork_images').insert({\n222:             artwork_id: artworkId, url: publicUrl, is_primary: (count + i) === 0, sort_order: count + i,\n223:           })\n224:           if (insertErr) throw insertErr\n225:         }\n226:       }\n227:       setSuccess('Saved'); setEdit(null); load()\n228:     } catch (e) { setError(e.message) }\n229:     setBusy(false)\n230:   }\n231: \n232:   const handleDelete = async (id) => {\n233:     if (!confirm('Soft-delete this artwork?')) return\n234:     setBusy(true)\n235:     try {\n236:       const supabase = await getAdminClient()\n237:       const { error } = await supabase.from('artworks').update({ deleted_at: new Date().toISOString() }).eq('id', id)\n238:       if (error) throw error\n239:       setSuccess('Deleted'); load()\n240:     } catch (e) { setError(e.message) }\n241:     setBusy(false)\n242:   }\n243: \n244:   const handleExport = () => {\n245:     const allItems = []\n246:     grouped.forEach((g) => g.artworks.forEach((a) => allItems.push(a)))\n247:     uncollected.forEach((a) => allItems.push(a))\n248:     const blob = new Blob([JSON.stringify(allItems, null, 2)], { type: 'application/json' })\n249:     const url = URL.createObjectURL(blob)\n250:     const a = document.createElement('a'); a.href = url; a.download = 'artworks-export.json'; a.click()\n251:     URL.revokeObjectURL(url)\n252:   }\n253: \n254:   const toggleField = (id, field) => {\n255:     const item = allArts.find(a => a.id === id)\n256:     if (!item) return\n257:     item[field] = !item[field]\n258:     setDirtyCount((c) => c + 1)\n259:     setBusy(true)\n260:     getAdminClient().then((supabase) =>\n261:       supabase.from('artworks').update({ [field]: item[field] }).eq('id', id)\n262:     ).then(({ error }) => {\n263:       if (error) throw error\n264:     }).catch((e) => {\n265:       item[field] = !item[field]\n266:       setDirtyCount((c) => c + 1)\n267:       setError(e.message)\n268:     }).finally(() => setBusy(false))\n269:   }\n270: \n271:   return (\n272:     <div>\n273:       <div style={{ display: 'flex', gap: 10, marginBottom: 20, flexWrap: 'wrap' }}>\n274:         <button className=\"btn btn-primary\" onClick={() => setEdit({})} disabled={busy}>+ New Artwork</button>\n275:         <button className=\"btn btn-secondary\" onClick={handleExport}>Export JSON</button>\n276:         {dirty && (\n277:           <button className=\"btn btn-primary\" onClick={saveOrder} disabled={busy} style={{ background: 'var(--coffee)', color: '#fff' }}>\n278:             {busy ? 'Saving...' : 'Save Order'}\n279:           </button>\n280:         )}\n281:         {dirty && <span style={{ fontSize: 12, color: 'var(--slate-gray)', alignSelf: 'center' }}>Unsaved changes</span>}\n282:       </div>\n283: \n284:       {edit && <ArtworkForm item={edit} collections={collections}\n285:         onSave={handleSave} onCancel={() => setEdit(null)} busy={busy} />}\n286: \n287:       <div className=\"admin-table-wrap artworks-table\">\n288:         <table>\n289:           <thead>\n290:             <tr>\n291:               <th style={{ width: 70 }}>#</th><th>Image</th><th>Title</th><th>Collection</th><th>Year</th><th>Status</th><th>Price</th><th>Featured</th><th>On Sale</th><th>Actions</th>\n292:             </tr>\n293:           </thead>\n294:           <tbody>\n295:             {onSaleArts.length > 0 && (\n296:               <Fragment>\n297:                 <tr className=\"admin-group-header\">\n298:                   <td colSpan={10} style={{ padding: '8px 12px', fontWeight: 700, fontSize: 13, color: '#dc2626', background: '#fef2f2' }}>\n299:                     On Sale\n300:                   </td>\n301:                 </tr>\n302:                 {onSaleArts.map((a, ai) => (\n303:                   <tr key={a.id} draggable={!busy}\n304:                     onDragStart={(e) => handleDragStart(e, 'on-sale', ai, false)}\n305:                     onDragOver={handleDragOver}\n306:                     onDrop={(e) => handleDrop(e, 'on-sale', ai, false)}\n307:                     style={{ cursor: 'grab' }}\n308:                   >\n309:                     <td style={{ whiteSpace: 'nowrap' }}>\n310:                       <span style={{ cursor: 'grab', fontSize: 14, color: 'var(--slate-gray)', marginRight: 4 }}>&#x22EE;</span>\n311:                       <button disabled={busy} onClick={() => arrowUp('on-sale', ai, false)} style={arrowMini}>&#9650;</button>\n312:                       <button disabled={busy} onClick={() => arrowDown('on-sale', ai, false)} style={arrowMini}>&#9660;</button>\n313:                     </td>\n314:                     <td>{a.artwork_images?.[0]?.url ? <img src={a.artwork_images[0].url} alt=\"\" style={{ width: 40, height: 40, objectFit: 'cover', borderRadius: 4 }} /> : '—'}</td>\n315:                     <td>{a.title}</td>\n316:                     <td style={{ fontSize: 12, color: 'var(--slate-gray)' }}>{a.collection_id ? 'Mixed' : '—'}</td>\n317:                     <td>{a.year}</td>\n318:                     <td>{a.status}</td>\n319:                     <td>EGP {a.price?.toLocaleString()}</td>\n320:                     <td style={{ whiteSpace: 'nowrap' }}>\n321:                       <label style={{ marginRight: 10 }}><input type=\"checkbox\" checked={!!a.is_featured} disabled={busy} onChange={() => toggleField(a.id, 'is_featured')} /><span className=\"ml\">Featured</span></label>\n322:                     </td>\n323:                     <td style={{ whiteSpace: 'nowrap' }}>\n324:                       <label style={{ marginRight: 10 }}><input type=\"checkbox\" checked={!!a.is_on_sale} disabled={busy} onChange={() => toggleField(a.id, 'is_on_sale')} /><span className=\"ml\">On Sale</span></label>\n325:                     </td>\n326:                     \n327:                     <td style={{ whiteSpace: 'nowrap' }}>\n328:                       <button className=\"btn btn-secondary\" style={{ fontSize: 12, padding: '4px 12px', marginRight: 6 }} onClick={() => setEdit(a)}>Edit</button>\n329:                       <button className=\"btn btn-secondary\" style={{ fontSize: 12, padding: '4px 12px', background: 'var(--caput-mortuum)', color: '#fff' }} onClick={() => handleDelete(a.id)} disabled={busy}>Delete</button>\n330:                     </td>\n331:                   </tr>\n332:                 ))}\n333:               </Fragment>\n334:             )}\n335:             {grouped.map((g) => (\n336:               <Fragment key={g.collection.id}>\n337:                 <tr className=\"admin-group-header\">\n338:                   <td colSpan={10} style={{ padding: '8px 12px', fontWeight: 700, fontSize: 13, color: 'var(--coffee)', background: '#f5f0e8' }}>\n339:                     {g.collection.title}\n340:                   </td>\n341:                 </tr>\n342:                 {g.artworks.length === 0 && (\n343:                   <tr><td colSpan={10} style={{ padding: 6, fontSize: 12, color: 'var(--slate-gray)', fontStyle: 'italic' }}>No artworks in this collection</td></tr>\n344:                 )}\n345:                 {g.artworks.map((a, ai) => (\n346:                   <tr key={a.id} draggable={!busy}\n347:                     onDragStart={(e) => handleDragStart(e, g.collection.id, ai, false)}\n348:                     onDragOver={handleDragOver}\n349:                     onDrop={(e) => handleDrop(e, g.collection.id, ai, false)}\n350:                     style={{ cursor: 'grab' }}\n351:                   >\n352:                     <td style={{ whiteSpace: 'nowrap' }}>\n353:                       <span style={{ cursor: 'grab', fontSize: 14, color: 'var(--slate-gray)', marginRight: 4 }}>&#x22EE;</span>\n354:                       <button disabled={busy} onClick={() => arrowUp(g.collection.id, ai, false)} style={arrowMini}>&#9650;</button>\n355:                       <button disabled={busy} onClick={() => arrowDown(g.collection.id, ai, false)} style={arrowMini}>&#9660;</button>\n356:                     </td>\n357:                     <td>{a.artwork_images?.[0]?.url ? <img src={a.artwork_images[0].url} alt=\"\" style={{ width: 40, height: 40, objectFit: 'cover', borderRadius: 4 }} /> : '—'}</td>\n358:                     <td>{a.title}</td>\n359:                     <td style={{ fontSize: 12, color: 'var(--slate-gray)' }}>{g.collection.title}</td>\n360:                     <td>{a.year}</td>\n361:                     <td>{a.status}</td>\n362:                     <td>EGP {a.price?.toLocaleString()}</td>\n363:                     <td style={{ whiteSpace: 'nowrap' }}>\n364:                       <label style={{ marginRight: 10 }}><input type=\"checkbox\" checked={!!a.is_featured} disabled={busy} onChange={() => toggleField(a.id, 'is_featured')} /><span className=\"ml\">Featured</span></label>\n365:                     </td>\n366:                     <td style={{ whiteSpace: 'nowrap' }}>\n367:                       <label style={{ marginRight: 10 }}><input type=\"checkbox\" checked={!!a.is_on_sale} disabled={busy} onChange={() => toggleField(a.id, 'is_on_sale')} /><span className=\"ml\">On Sale</span></label>\n368:                     </td>\n369:                     \n370:                     <td style={{ whiteSpace: 'nowrap' }}>\n371:                       <button className=\"btn btn-secondary\" style={{ fontSize: 12, padding: '4px 12px', marginRight: 6 }} onClick={() => setEdit(a)}>Edit</button>\n372:                       <button className=\"btn btn-secondary\" style={{ fontSize: 12, padding: '4px 12px', background: 'var(--caput-mortuum)', color: '#fff' }} onClick={() => handleDelete(a.id)} disabled={busy}>Delete</button>\n373:                     </td>\n374:                   </tr>\n375:                 ))}\n376:               </Fragment>\n377:             ))}\n378:             {uncollected.length > 0 && (\n379:               <Fragment>\n380:                 <tr className=\"admin-group-header\">\n381:                   <td colSpan={10} style={{ padding: '8px 12px', fontWeight: 700, fontSize: 13, color: 'var(--slate-gray)', background: '#f5f0e8', fontStyle: 'italic' }}>No Collection</td>\n382:                 </tr>\n383:                 {uncollected.map((a, ai) => (\n384:                   <tr key={a.id} draggable={!busy}\n385:                     onDragStart={(e) => handleDragStart(e, 'unc', ai, true)}\n386:                     onDragOver={handleDragOver}\n387:                     onDrop={(e) => handleDrop(e, 'unc', ai, true)}\n388:                     style={{ cursor: 'grab' }}\n389:                   >\n390:                     <td style={{ whiteSpace: 'nowrap' }}>\n391:                       <span style={{ cursor: 'grab', fontSize: 14, color: 'var(--slate-gray)', marginRight: 4 }}>&#x22EE;</span>\n392:                       <button disabled={busy} onClick={() => arrowUp('unc', ai, true)} style={arrowMini}>&#9650;</button>\n393:                       <button disabled={busy} onClick={() => arrowDown('unc', ai, true)} style={arrowMini}>&#9660;</button>\n394:                     </td>\n395:                     <td>{a.artwork_images?.[0]?.url ? <img src={a.artwork_images[0].url} alt=\"\" style={{ width: 40, height: 40, objectFit: 'cover', borderRadius: 4 }} /> : '—'}</td>\n396:                     <td>{a.title}</td>\n397:                     <td style={{ fontSize: 12, color: 'var(--slate-gray)' }}>—</td>\n398:                     <td>{a.year}</td>\n399:                     <td>{a.status}</td>\n400:                     <td>EGP {a.price?.toLocaleString()}</td>\n401:                     <td style={{ whiteSpace: 'nowrap' }}>\n402:                       <label style={{ marginRight: 10 }}><input type=\"checkbox\" checked={!!a.is_featured} disabled={busy} onChange={() => toggleField(a.id, 'is_featured')} /><span className=\"ml\">Featured</span></label>\n403:                     </td>\n404:                     <td style={{ whiteSpace: 'nowrap' }}>\n405:                       <label style={{ marginRight: 10 }}><input type=\"checkbox\" checked={!!a.is_on_sale} disabled={busy} onChange={() => toggleField(a.id, 'is_on_sale')} /><span className=\"ml\">On Sale</span></label>\n406:                     </td>\n407:                     \n408:                     <td style={{ whiteSpace: 'nowrap' }}>\n409:                       <button className=\"btn btn-secondary\" style={{ fontSize: 12, padding: '4px 12px', marginRight: 6 }} onClick={() => setEdit(a)}>Edit</button>\n410:                       <button className=\"btn btn-secondary\" style={{ fontSize: 12, padding: '4px 12px', background: 'var(--caput-mortuum)', color: '#fff' }} onClick={() => handleDelete(a.id)} disabled={busy}>Delete</button>\n411:                     </td>\n412:                   </tr>\n413:                 ))}\n414:               </Fragment>\n415:             )}\n416:           </tbody>\n417:         </table>\n418:       </div>\n419:     </div>\n420:   )\n421: }\n422: \n423: const arrowMini = {\n424:   border: 'none', background: 'transparent', cursor: 'pointer',\n425:   fontSize: 9, padding: '1px 3px', color: 'var(--slate-gray)',\n426: }\n427: \n428: function cmToIn(cm) {\n429:   return cm ? (parseFloat(cm) * 0.393701).toFixed(1) : null\n430: }\n431: \n432: function ArtworkForm({ item, collections, onSave, onCancel, busy }) {\n433:   const [form, setForm] = useState({\n434:     id: item.id || null, title: item.title || '', collection_id: item.collection_id || '',\n435:     year: item.year || '', medium: item.medium || '',\n436:     width_cm: item.width_cm || '', height_cm: item.height_cm || '', depth_cm: item.depth_cm || '', weight_kg: item.weight_kg || '',\n437:     description: item.description || '', price: item.price || '',\n438:     status: item.status || 'available', is_featured: item.is_featured || false, is_on_sale: item.is_on_sale || false,\n439:     is_published: item.is_published !== undefined ? item.is_published : true,\n440:     sort_order: item.sort_order ?? (item.id ? item.sort_order : 0), files: null,\n441:   })\n442:   const [existingImages, setExistingImages] = useState(item.artwork_images || [])\n443:   const [imageBusy, setImageBusy] = useState(false)\n444: \n445:   const set = (key) => (e) => setForm({ ...form, [key]: e.target.value })\n446:   const setNum = (key) => (e) => setForm({ ...form, [key]: e.target.value === '' ? '' : e.target.value })\n447: \n448:   const handleDeleteImage = async (imageId) => {\n449:     if (!confirm('Delete this image?')) return\n450:     setImageBusy(true)\n451:     try {\n452:       const supabase = await getAdminClient()\n453:       await supabase.from('artwork_images').delete().eq('id', imageId)\n454:       setExistingImages((prev) => prev.filter((img) => img.id !== imageId))\n455:     } catch (e) { alert(e.message) }\n456:     setImageBusy(false)\n457:   }\n458: \n459:   const handleSetPrimary = async (imageId) => {\n460:     if (!form.id) return\n461:     setImageBusy(true)\n462:     try {\n463:       const supabase = await getAdminClient()\n464:       await supabase.from('artwork_images').update({ is_primary: false }).eq('artwork_id', form.id)\n465:       await supabase.from('artwork_images').update({ is_primary: true }).eq('id', imageId)\n466:       setExistingImages((prev) => prev.map((img) => ({ ...img, is_primary: img.id === imageId })))\n467:     } catch (e) { alert(e.message) }\n468:     setImageBusy(false)\n469:   }\n470: \n471:   return (\n472:     <div className=\"admin-form-card\">\n473:       <h4>{form.id ? 'Edit Artwork' : 'New Artwork'}</h4>\n474:       <div className=\"admin-form-grid\">\n475:         <div className=\"admin-field\">\n476:           <label>Title</label>\n477:           <input placeholder=\"e.g. Sunset over Cairo\" value={form.title} onChange={set('title')} />\n478:         </div>\n479:         <div className=\"admin-field\">\n480:           <label>Collection</label>\n481:           <select value={form.collection_id} onChange={set('collection_id')}>\n482:             <option value=\"\">No collection</option>\n483:             {collections.map((c) => <option key={c.id} value={c.id}>{c.title}</option>)}\n484:           </select>\n485:         </div>\n486:         <div className=\"admin-field\">\n487:           <label>Year</label>\n488:           <input placeholder=\"e.g. 2025\" value={form.year} onChange={set('year')} />\n489:         </div>\n490:         <div className=\"admin-field\">\n491:           <label>Medium</label>\n492:           <input placeholder=\"e.g. Oil on canvas\" value={form.medium} onChange={set('medium')} />\n493:         </div>\n494:         <div className=\"admin-field\">\n495:           <label>Width (cm)</label>\n496:           <input placeholder=\"0\" type=\"number\" value={form.width_cm} onChange={setNum('width_cm')} />\n497:           {form.width_cm && <span className=\"inch-hint\">≈ {cmToIn(form.width_cm)} in</span>}\n498:         </div>\n499:         <div className=\"admin-field\">\n500:           <label>Height (cm)</label>\n501:           <input placeholder=\"0\" type=\"number\" value={form.height_cm} onChange={setNum('height_cm')} />\n502:           {form.height_cm && <span className=\"inch-hint\">≈ {cmToIn(form.height_cm)} in</span>}\n503:         </div>\n504:         <div className=\"admin-field\">\n505:           <label>Depth (cm)</label>\n506:           <input placeholder=\"Frame thickness in cm\" type=\"number\" value={form.depth_cm} onChange={setNum('depth_cm')} />\n507:         </div>\n508:         <div className=\"admin-field\">\n509:           <label>Weight (kg)</label>\n510:           <input placeholder=\"e.g., 2.5\" type=\"number\" value={form.weight_kg} onChange={setNum('weight_kg')} />\n511:         </div>\n512:         <div className=\"admin-field\">\n513:           <label>Price</label>\n514:           <input placeholder=\"0\" type=\"number\" value={form.price} onChange={setNum('price')} />\n515:         </div>\n516:         <div className=\"admin-field\">\n517:           <label>Status</label>\n518:           <select value={form.status} onChange={set('status')}>\n519:             <option value=\"available\">Available</option><option value=\"reserved\">Reserved</option><option value=\"sold\">Sold</option><option value=\"not_for_sale\">Not for Sale</option>\n520:           </select>\n521:         </div>\n522:         <div className=\"admin-checkboxes\">\n523:           <label><input type=\"checkbox\" checked={form.is_featured} onChange={(e) => setForm({ ...form, is_featured: e.target.checked })} /> Featured</label>\n524:           <label><input type=\"checkbox\" checked={form.is_on_sale} onChange={(e) => setForm({ ...form, is_on_sale: e.target.checked })} /> Mark Painting as On Sale</label>\n525:           <label><input type=\"checkbox\" checked={form.is_published} onChange={(e) => setForm({ ...form, is_published: e.target.checked })} /> Published</label>\n526:         </div>\n527:         <div className=\"admin-field full\">\n528:           <label>Images — select multiple</label>\n529:           <input type=\"file\" accept=\"image/*\" multiple onChange={(e) => setForm({ ...form, files: e.target.files })} />\n530:         </div>\n531:       </div>\n532:       <div className=\"admin-field\" style={{ marginTop: 12 }}>\n533:         <label>Description</label>\n534:         <textarea placeholder=\"Describe the artwork...\" value={form.description} onChange={set('description')} />\n535:       </div>\n536: \n537:       {existingImages.length > 0 && (\n538:         <div style={{ marginTop: 16 }}>\n539:           <p style={{ fontSize: 13, fontWeight: 600, marginBottom: 8 }}>Images ({existingImages.length})</p>\n540:           <div className=\"admin-image-grid\">\n541:             {existingImages.map((img) => (\n542:               <div key={img.id} className=\"admin-image-thumb\">\n543:                 <img src={img.url} alt=\"\" style={{ border: img.is_primary ? '2px solid var(--coffee)' : '2px solid transparent' }} />\n544:                 {img.is_primary && <span style={{ position: 'absolute', top: 2, left: 2, fontSize: 9, background: 'var(--coffee)', color: '#fff', padding: '1px 5px', borderRadius: 3 }}>PRIMARY</span>}\n545:                 <div style={{ position: 'absolute', bottom: 2, right: 2, display: 'flex', gap: 2 }}>\n546:                   {!img.is_primary && <button onClick={() => handleSetPrimary(img.id)} disabled={imageBusy} style={{ fontSize: 10, padding: '2px 5px', border: 'none', borderRadius: 3, background: 'var(--space-cadet)', color: '#fff', cursor: 'pointer' }}>P</button>}\n547:                   <button onClick={() => handleDeleteImage(img.id)} disabled={imageBusy} style={{ fontSize: 10, padding: '2px 5px', border: 'none', borderRadius: 3, background: 'var(--caput-mortuum)', color: '#fff', cursor: 'pointer' }}>X</button>\n548:                 </div>\n549:               </div>\n550:             ))}\n551:           </div>\n552:         </div>\n553:       )}\n554: \n555:       <div style={{ display: 'flex', gap: 10, marginTop: 16 }}>\n556:         <button className=\"btn btn-primary\" onClick={() => onSave(form)} disabled={busy}>{busy ? 'Saving...' : 'Save'}</button>\n557:         <button className=\"btn btn-secondary\" onClick={onCancel}>Cancel</button>\n558:       </div>\n559:     </div>\n560:   )\n561: }\n562: \n563: /* ─── Collections ─── */\n564: function CollectionsManager({ setError, setSuccess }) {\n565:   const [items, setItems] = useState([])\n566:   const [edit, setEdit] = useState(null)\n567:   const [busy, setBusy] = useState(false)\n568:   const [dirty, setDirty] = useState(false)\n569:   const dragSrc = useRef(null)\n570: \n571:   const load = async () => {\n572:     try {\n573:       const supabase = await getAdminClient()\n574:       const [collsResp, onSaleCountResp] = await Promise.all([\n575:         supabase.from('collections').select('*, artworks(*)').order('sort_order', { ascending: true }),\n576:         supabase.from('artworks').select('id', { count: 'exact', head: true }).eq('is_on_sale', true).is('deleted_at', null),\n577:       ])\n578:       if (collsResp.error) throw collsResp.error\n579: \n580:       const allColls = collsResp.data || []\n581:       const onSaleDb = allColls.find((c) => c.id === ON_SALE_COLLECTION_ID)\n582:       const dbColls = allColls.filter((c) => c.id !== ON_SALE_COLLECTION_ID)\n583: \n584:       // If the On Sale DB row is missing, re-create it\n585:       if (!onSaleDb) {\n586:         const { data: profile } = await supabase.from('artist_profile').select('id').maybeSingle()\n587:         await supabase.from('collections').insert({\n588:           id: ON_SALE_COLLECTION_ID,\n589:           artist_id: profile?.id || '00000000-0000-0000-0000-000000000000',\n590:           title: 'On Sale',\n591:           description: 'Artworks currently on sale',\n592:           sort_order: -1,\n593:           is_published: true,\n594:         })\n595:         return load()\n596:       }\n597: \n598:       // Build the On Sale entry using DB data but with dynamic artwork count\n599:       const onSaleEntry = {\n600:         ...onSaleDb,\n601:         artworks: [],\n602:         _onSaleCount: onSaleCountResp.count || 0,\n603:       }\n604: \n605:       // Insert at correct position based on sort_order\n606:       dbColls.sort((a, b) => a.sort_order - b.sort_order)\n607:       const insertIdx = dbColls.findIndex((c) => c.sort_order > onSaleEntry.sort_order)\n608:       if (insertIdx === -1) {\n609:         setItems([...dbColls, onSaleEntry])\n610:       } else {\n611:         const sorted = [...dbColls]\n612:         sorted.splice(insertIdx, 0, onSaleEntry)\n613:         setItems(sorted)\n614:       }\n615:       setDirty(false)\n616:     } catch (e) { setError(e.message) }\n617:   }\n618:   useEffect(() => { load() }, [])\n619: \n620:   /* ── drag-and-drop ── */\n621:   const handleDragStart = (e, index) => {\n622:     dragSrc.current = index\n623:     e.dataTransfer.effectAllowed = 'move'\n624:     e.dataTransfer.setData('text/plain', '')\n625:   }\n626:   const handleDragOver = (e) => { e.preventDefault(); e.dataTransfer.dropEffect = 'move' }\n627:   const handleDrop = (e, targetIndex) => {\n628:     e.preventDefault()\n629:     const src = dragSrc.current\n630:     dragSrc.current = null\n631:     if (src === null || src === targetIndex) return\n632:     setItems(prev => {\n633:       const next = [...prev]\n634:       const [moved] = next.splice(src, 1)\n635:       next.splice(targetIndex, 0, moved)\n636:       return next\n637:     })\n638:     setDirty(true)\n639:   }\n640: \n641:   /* ── local arrow reorder ── */\n642:   const arrowUp = (idx) => {\n643:     if (idx <= 0) return\n644:     setItems(prev => { const n = [...prev]; [n[idx - 1], n[idx]] = [n[idx], n[idx - 1]]; return n })\n645:     setDirty(true)\n646:   }\n647:   const arrowDown = (idx) => {\n648:     if (idx >= items.length - 1) return\n649:     setItems(prev => { const n = [...prev]; [n[idx], n[idx + 1]] = [n[idx + 1], n[idx]]; return n })\n650:     setDirty(true)\n651:   }\n652: \n653:   /* ── batch save order ── */\n654:   const saveOrder = async () => {\n655:     setBusy(true)\n656:     try {\n657:       const supabase = await getAdminClient()\n658:       await Promise.all(items.map((item, i) => supabase.from('collections').update({ sort_order: i }).eq('id', item.id)))\n659:       setSuccess('Order saved!')\n660:       setDirty(false)\n661:     } catch (e) { setError(e.message) }\n662:     setBusy(false)\n663:   }\n664: \n665:   const handleSave = async (form) => {\n666:     setBusy(true); setError(''); setSuccess('')\n667:     try {\n668:       const supabase = await getAdminClient()\n669:       let coverUrl = form.cover_image\n670: \n671:       if (form.coverFile) {\n672:         const ext = form.coverFile.name.split('.').pop()\n673:         const filePath = `collections/${Date.now()}_${Math.random().toString(36).slice(2, 6)}.${ext}`\n674:         const { error: uploadErr } = await supabase.storage.from('artworks').upload(filePath, form.coverFile, { contentType: form.coverFile.type })\n675:         if (uploadErr) throw uploadErr\n676:         const { data: { publicUrl } } = supabase.storage.from('artworks').getPublicUrl(filePath)\n677:         coverUrl = publicUrl\n678:       }\n679: \n680:       if (form.id) {\n681:         const payload = {\n682:           title: form.title, description: form.description, cover_image: coverUrl,\n683:           sort_order: form.sort_order || 0, is_published: form.is_published !== undefined ? form.is_published : true,\n684:         }\n685:         const { error } = await supabase.from('collections').update(payload).eq('id', form.id)\n686:         if (error) throw error\n687:       } else {\n688:         const { data: profile } = await supabase.from('artist_profile').select('id').maybeSingle()\n689:         if (!profile) throw new Error('No artist profile found')\n690:         const { error } = await supabase.from('collections').insert({ artist_id: profile.id, title: form.title, description: form.description, cover_image: coverUrl, sort_order: form.sort_order || 0, is_published: form.is_published !== undefined ? form.is_published : true })\n691:         if (error) throw error\n692:       }\n693: \n694:       setSuccess('Saved'); setEdit(null); load()\n695:     } catch (e) { setError(e.message) }\n696:     setBusy(false)\n697:   }\n698: \n699:   const handleDelete = async (id) => {\n700:     if (!confirm('Delete this collection? (Artworks in it will not be deleted)')) return\n701:     try {\n702:       const supabase = await getAdminClient()\n703:       const { error } = await supabase.from('collections').delete().eq('id', id)\n704:       if (error) throw error\n705:       setSuccess('Deleted'); load()\n706:     } catch (e) { setError(e.message) }\n707:   }\n708: \n709:   return (\n710:     <div>\n711:       <div style={{ display: 'flex', gap: 10, marginBottom: 16, flexWrap: 'wrap', alignItems: 'center' }}>\n712:         <button className=\"btn btn-primary\" onClick={() => setEdit({})}>+ New Collection</button>\n713:         {dirty && (\n714:           <>\n715:             <button className=\"btn btn-primary\" onClick={saveOrder} disabled={busy} style={{ background: 'var(--coffee)', color: '#fff' }}>\n716:               {busy ? 'Saving...' : 'Save Order'}\n717:             </button>\n718:             <span style={{ fontSize: 12, color: 'var(--slate-gray)' }}>Unsaved changes</span>\n719:           </>\n720:         )}\n721:       </div>\n722:       {edit && <CollectionForm item={edit} onSave={handleSave} onCancel={() => setEdit(null)} busy={busy} />}\n723:       {items.map((c, i) => {\n724:         const isOnSale = c.id === ON_SALE_COLLECTION_ID\n725:         return (\n726:         <div key={c.id} className=\"admin-list-item\" draggable={!busy}\n727:           onDragStart={(e) => handleDragStart(e, i)}\n728:           onDragOver={handleDragOver}\n729:           onDrop={(e) => handleDrop(e, i)}\n730:           style={{ cursor: 'grab' }}\n731:         >\n732:           <div className=\"admin-list-item-info\" style={{ display: 'flex', alignItems: 'center', gap: 8 }}>\n733:             <span style={{ fontSize: 16, color: isOnSale ? '#dc2626' : 'var(--slate-gray)' }}>{'\\u22EE'}</span>\n734:             <div style={{ display: 'flex', flexDirection: 'column', gap: 1 }}>\n735:               <button disabled={busy} onClick={() => arrowUp(i)} style={arrowMini}>&#9650;</button>\n736:               <button disabled={busy} onClick={() => arrowDown(i)} style={arrowMini}>&#9660;</button>\n737:             </div>\n738:             <div>\n739:               <strong style={{ color: isOnSale ? '#dc2626' : 'inherit' }}>{c.title}</strong>\n740:               <span style={{ fontSize: 12, color: 'var(--slate-gray)', marginLeft: 6 }}>({isOnSale ? (c._onSaleCount || 0) : (c.artworks || []).length} artworks)</span>\n741:               {c.description && <p style={{ fontSize: 12, color: 'var(--text-muted)', marginTop: 2 }}>{c.description.slice(0, 100)}</p>}\n742:             </div>\n743:           </div>\n744:           <div className=\"admin-list-item-actions\">\n745:             <button className=\"btn btn-secondary\" style={{ fontSize: 12, padding: '2px 10px' }} onClick={() => setEdit(c)}>Edit</button>\n746:             <button className=\"btn btn-secondary\" style={{ fontSize: 12, padding: '2px 10px', background: 'var(--caput-mortuum)', color: '#fff' }} onClick={() => handleDelete(c.id)}>Del</button>\n747:           </div>\n748:         </div>\n749:         )\n750:       })}\n751:     </div>\n752:   )\n753: }\n754: \n755: function CollectionForm({ item, onSave, onCancel, busy }) {\n756:   const [form, setForm] = useState({ id: item.id || null, title: item.title || '', description: item.description || '', cover_image: item.cover_image || '', sort_order: item.sort_order || 0, is_published: item.is_published !== undefined ? item.is_published : true, coverFile: null })\n757:   const [uploading, setUploading] = useState(false)\n758: \n759:   const handleSave = async () => {\n760:     setUploading(true)\n761:     await onSave(form)\n762:     setUploading(false)\n763:   }\n764: \n765:   return (\n766:     <div className=\"admin-form-card\">\n767:       <h4>{form.id ? 'Edit Collection' : 'New Collection'}</h4>\n768:       <div className=\"admin-form-grid\">\n769:         <div className=\"admin-field\">\n770:           <label>Collection Title</label>\n771:           <input placeholder=\"e.g. Abstract Landscapes\" value={form.title} onChange={(e) => setForm({ ...form, title: e.target.value })} />\n772:         </div>\n773: \n774:         <div className=\"admin-field\">\n775:           <label>Cover Image</label>\n776:           {form.cover_image && <img src={form.cover_image} alt=\"Cover\" style={{ width: 80, height: 80, objectFit: 'cover', borderRadius: 6, marginBottom: 6, display: 'block' }} />}\n777:           <input type=\"file\" accept=\"image/*\" onChange={(e) => setForm({ ...form, coverFile: e.target.files[0] })} />\n778:         </div>\n779:         <div className=\"admin-checkboxes\">\n780:           <label><input type=\"checkbox\" checked={form.is_published} onChange={(e) => setForm({ ...form, is_published: e.target.checked })} /> Published</label>\n781:         </div>\n782:         <div className=\"admin-field full\">\n783:           <label>Description</label>\n784:           <textarea placeholder=\"Describe the collection...\" value={form.description} onChange={(e) => setForm({ ...form, description: e.target.value })} />\n785:         </div>\n786:       </div>\n787:       <div style={{ display: 'flex', gap: 10, marginTop: 16 }}>\n788:         <button className=\"btn btn-primary\" onClick={() => onSave(form)} disabled={busy}>{busy ? 'Saving...' : 'Save'}</button>\n789:         <button className=\"btn btn-secondary\" onClick={onCancel}>Cancel</button>\n790:       </div>\n791:     </div>\n792:   )\n793: }\n794: \n795: /* ─── Orders ─── */\n796: function OrdersManager({ setError, setSuccess }) {\n797:   const [items, setItems] = useState([])\n798:   const [busy, setBusy] = useState(false)\n799:   const [filter, setFilter] = useState('')\n800: \n801:   const STATUSES = ['pending', 'paid', 'still packaging', 'sent to shipping', 'completed', 'cancelled']\n802: \n803:   const load = async () => {\n804:     try {\n805:       const supabase = await getServiceSupabase()\n806:       const { data, error } = await supabase\n807:         .from('orders')\n808:         .select('*, order_items(*, artworks(title))')\n809:         .order('created_at', { ascending: false })\n810:       if (error) throw error\n811:       setItems(data || [])\n812:     } catch (e) { setError(e.message) }\n813:   }\n814:   useEffect(() => { load() }, [])\n815: \n816:   const updateStatus = async (id, status) => {\n817:     setBusy(true)\n818:     try {\n819:       const supabase = await getServiceSupabase()\n820:       const { error } = await supabase.from('orders').update({ status }).eq('id', id)\n821:       if (error) throw error\n822:       setSuccess(`Order ${id.slice(0, 8)} → ${status}`)\n823:       load()\n824:     } catch (e) { setError(e.message) }\n825:     setBusy(false)\n826:   }\n827: \n828:   const filtered = filter ? items.filter((o) => o.status === filter) : items\n829: \n830:   return (\n831:     <div>\n832:       <div style={{ display: 'flex', gap: 8, marginBottom: 16, flexWrap: 'wrap', alignItems: 'center' }}>\n833:         <strong style={{ fontSize: 13 }}>Filter:</strong>\n834:         <button className=\"btn btn-secondary\" style={{ fontSize: 12, padding: '4px 12px', background: !filter ? 'var(--coffee)' : '', color: !filter ? '#fff' : '' }} onClick={() => setFilter('')}>All</button>\n835:         {STATUSES.map((s) => (\n836:           <button key={s} className=\"btn btn-secondary\" style={{ fontSize: 12, padding: '4px 12px', background: filter === s ? 'var(--coffee)' : '', color: filter === s ? '#fff' : '' }} onClick={() => setFilter(s)}>{s}</button>\n837:         ))}\n838:         <span style={{ fontSize: 12, color: 'var(--slate-gray)', marginLeft: 8 }}>{filtered.length} orders</span>\n839:       </div>\n840: \n841:       <div className=\"admin-table-wrap\">\n842:         <table>\n843:           <thead>\n844:             <tr>\n845:               <th>ID</th><th>Name</th><th>Email</th><th>Phone</th><th>Address</th><th>Total</th><th>Artworks</th><th>Status</th><th>Date</th>\n846:             </tr>\n847:           </thead>\n848:           <tbody>\n849:             {filtered.length === 0 && (\n850:               <tr><td colSpan={9} style={{ padding: 20, textAlign: 'center', color: 'var(--slate-gray)', fontSize: 13 }}>No orders found</td></tr>\n851:             )}\n852:             {filtered.map((o) => (\n853:               <tr key={o.id}>\n854:                 <td style={{ fontSize: 11, fontFamily: 'monospace' }}>{o.id.slice(0, 8)}</td>\n855:                 <td>{o.customer_name}</td>\n856:                 <td>{o.buyer_email}</td>\n857:                 <td>{o.customer_phone}</td>\n858:                 <td style={{ fontSize: 12 }}>\n859:                   {[o.street_address, o.building_number, o.apartment_number, o.customer_city, o.customer_governorate].filter(Boolean).join(', ')}\n860:                 </td>\n861:                 <td>{o.total_items_cost ? `${o.total_items_cost} EGP` : '\\u2014'}</td>\n862:                 <td style={{ fontSize: 12 }}>\n863:                   {(o.order_items || []).map((oi) => oi.artworks?.title).filter(Boolean).join(', ') || '\\u2014'}\n864:                 </td>\n865:                 <td>\n866:                   <select value={o.status} onChange={(e) => updateStatus(o.id, e.target.value)} disabled={busy}\n867:                     style={{ padding: '4px 6px', borderRadius: 4, border: '1px solid var(--border)', fontSize: 12, background: '#fff', cursor: 'pointer' }}>\n868:                     {STATUSES.map((s) => <option key={s} value={s}>{s}</option>)}\n869:                   </select>\n870:                 </td>\n871:                 <td style={{ fontSize: 12, whiteSpace: 'nowrap' }}>\n872:                   {new Date(o.created_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}\n873:                 </td>\n874:               </tr>\n875:             ))}\n876:           </tbody>\n877:         </table>\n878:       </div>\n879:     </div>\n880:   )\n881: }\n882: \n883: /* ─── Profile ─── */\n884: function ProfileManager({ setError, setSuccess }) {\n885:   const [form, setForm] = useState({ name: '', artist_statement: '', biography: '', research_academic: '', contact_email: '', contact_phone: '', instagram_url: '', tiktok_url: '' })\n886:   const [busy, setBusy] = useState(false)\n887: \n888:   useEffect(() => {\n889:     (async () => {\n890:       try {\n891:         const supabase = await getAdminClient()\n892:         const { data, error } = await supabase.from('artist_profile').select('*').maybeSingle()\n893:         if (error) throw error\n894:         if (data) setForm((prev) => ({ ...prev, ...data }))\n895:       } catch (e) { /* profile may not exist yet */ }\n896:     })()\n897:   }, [])\n898: \n899:   const handleSave = async () => {\n900:     setBusy(true); setError(''); setSuccess('')\n901:     try {\n902:       const supabase = await getAdminClient()\n903:       const { data: existing } = await supabase.from('artist_profile').select('id').maybeSingle()\n904:       if (existing) {\n905:         const { error } = await supabase.from('artist_profile').update(form).eq('id', existing.id)\n906:         if (error) throw error\n907:       } else {\n908:         const { error } = await supabase.from('artist_profile').insert(form)\n909:         if (error) throw error\n910:       }\n911:       setSuccess('Profile updated')\n912:     } catch (e) { setError(e.message) }\n913:     setBusy(false)\n914:   }\n915: \n916:   return (\n917:     <div className=\"admin-form-card\" style={{ maxWidth: 700 }}>\n918:       <h4>Profile</h4>\n919:       <div className=\"admin-form-grid\">\n920:         <div className=\"admin-field full\">\n921:           <label>Name</label>\n922:           <input placeholder=\"Your name\" value={form.name} onChange={(e) => setForm({ ...form, name: e.target.value })} />\n923:         </div>\n924:         <div className=\"admin-field full\">\n925:           <label>Artist Statement</label>\n926:           <textarea placeholder=\"Write your artist statement...\" value={form.artist_statement} onChange={(e) => setForm({ ...form, artist_statement: e.target.value })} style={{ minHeight: 120 }} />\n927:         </div>\n928:         <div className=\"admin-field full\">\n929:           <label>Biography</label>\n930:           <textarea placeholder=\"Write your biography...\" value={form.biography} onChange={(e) => setForm({ ...form, biography: e.target.value })} style={{ minHeight: 120 }} />\n931:         </div>\n932:         <div className=\"admin-field full\">\n933:           <label>Research & Academic</label>\n934:           <textarea placeholder=\"Academic background, research interests...\" value={form.research_academic} onChange={(e) => setForm({ ...form, research_academic: e.target.value })} style={{ minHeight: 100 }} />\n935:         </div>\n936:         <div className=\"admin-field\">\n937:           <label>Contact Email</label>\n938:           <input placeholder=\"email@example.com\" type=\"email\" value={form.contact_email} onChange={(e) => setForm({ ...form, contact_email: e.target.value })} />\n939:         </div>\n940:         <div className=\"admin-field\">\n941:           <label>Contact Phone</label>\n942:           <input placeholder=\"+20 100 000 0000\" value={form.contact_phone} onChange={(e) => setForm({ ...form, contact_phone: e.target.value })} />\n943:         </div>\n944:         <div className=\"admin-field\">\n945:           <label>Instagram URL</label>\n946:           <input placeholder=\"https://instagram.com/...\" value={form.instagram_url} onChange={(e) => setForm({ ...form, instagram_url: e.target.value })} />\n947:         </div>\n948:         <div className=\"admin-field\">\n949:           <label>TikTok URL</label>\n950:           <input placeholder=\"https://tiktok.com/...\" value={form.tiktok_url} onChange={(e) => setForm({ ...form, tiktok_url: e.target.value })} />\n951:         </div>\n952:       </div>\n953:       <button className=\"btn btn-primary\" onClick={handleSave} disabled={busy} style={{ marginTop: 16 }}>{busy ? 'Saving...' : 'Save Profile'}</button>\n954:     </div>\n955:   )\n956: }\n957: \n958: /* ─── Exhibitions ─── */\n959: function ExhibitionsManager({ setError, setSuccess }) {\n960:   return <CategoryManager category=\"exhibition\" label=\"Exhibition\" setError={setError} setSuccess={setSuccess} />\n961: }\n962: \n963: /* ─── Events ─── */\n964: function EventsManager({ setError, setSuccess }) {\n965:   return <CategoryManager category=\"event\" label=\"Event\" setError={setError} setSuccess={setSuccess} />\n966: }\n967: \n968: /* ─── Reusable category manager (exhibitions / events) ─── */\n969: function CategoryManager({ category, label, setError, setSuccess }) {\n970:   const [items, setItems] = useState([])\n971:   const [edit, setEdit] = useState(null)\n972:   const [busy, setBusy] = useState(false)\n973:   const [dirty, setDirty] = useState(false)\n974:   const dragSrc = useRef(null)\n975: \n976:   const load = async () => {\n977:     try {\n978:       const supabase = await getAdminClient()\n979:       const { data, error } = await supabase.from('exhibitions').select('*').eq('category', category).order('sort_order', { ascending: true })\n980:       if (error) throw error\n981:       setItems(data || [])\n982:       setDirty(false)\n983:     } catch (e) { setError(e.message) }\n984:   }\n985:   useEffect(() => { load() }, [])\n986: \n987:   const handleDragStart = (e, index) => {\n988:     dragSrc.current = index\n989:     e.dataTransfer.effectAllowed = 'move'\n990:     e.dataTransfer.setData('text/plain', '')\n991:   }\n992:   const handleDragOver = (e) => { e.preventDefault(); e.dataTransfer.dropEffect = 'move' }\n993:   const handleDrop = (e, targetIndex) => {\n994:     e.preventDefault()\n995:     const src = dragSrc.current\n996:     dragSrc.current = null\n997:     if (src === null || src === targetIndex) return\n998:     setItems(prev => {\n999:       const next = [...prev]\n1000:       const [moved] = next.splice(src, 1)\n1001:       next.splice(targetIndex, 0, moved)\n1002:       return next\n1003:     })\n1004:     setDirty(true)\n1005:   }\n1006: \n1007:   const arrowUp = (idx) => {\n1008:     if (idx <= 0) return\n1009:     setItems(prev => { const n = [...prev]; [n[idx - 1], n[idx]] = [n[idx], n[idx - 1]]; return n })\n1010:     setDirty(true)\n1011:   }\n1012:   const arrowDown = (idx) => {\n1013:     if (idx >= items.length - 1) return\n1014:     setItems(prev => { const n = [...prev]; [n[idx], n[idx + 1]] = [n[idx + 1], n[idx]]; return n })\n1015:     setDirty(true)\n1016:   }\n1017: \n1018:   const saveOrder = async () => {\n1019:     setBusy(true)\n1020:     try {\n1021:       const supabase = await getAdminClient()\n1022:       await Promise.all(items.map((item, i) => supabase.from('exhibitions').update({ sort_order: i }).eq('id', item.id)))\n1023:       setSuccess('Order saved!')\n1024:       setDirty(false)\n1025:     } catch (e) { setError(e.message) }\n1026:     setBusy(false)\n1027:   }\n1028: \n1029:   const handleSave = async (form) => {\n1030:     setBusy(true); setError(''); setSuccess('')\n1031:     try {\n1032:       const supabase = await getAdminClient()\n1033:       const data = { ...form, category }\n1034:       if (data.start_date) data.start_date = convertToDbDate(data.start_date)\n1035:       if (data.end_date) data.end_date = convertToDbDate(data.end_date)\n1036:       if (form.id) {\n1037:         const { error } = await supabase.from('exhibitions').update(data).eq('id', form.id)\n1038:         if (error) throw error\n1039:       } else {\n1040:         const { error } = await supabase.from('exhibitions').insert(data)\n1041:         if (error) throw error\n1042:       }\n1043:       setSuccess('Saved'); setEdit(null); load()\n1044:     } catch (e) { setError(e.message) }\n1045:     setBusy(false)\n1046:   }\n1047: \n1048:   const handleDelete = async (id) => {\n1049:     if (!confirm('Delete?')) return\n1050:     try {\n1051:       const supabase = await getAdminClient()\n1052:       const { error } = await supabase.from('exhibitions').delete().eq('id', id)\n1053:       if (error) throw error\n1054:       setSuccess('Deleted'); load()\n1055:     } catch (e) { setError(e.message) }\n1056:   }\n1057: \n1058:   return (\n1059:     <div>\n1060:       <div style={{ display: 'flex', gap: 10, marginBottom: 16, flexWrap: 'wrap', alignItems: 'center' }}>\n1061:         <button className=\"btn btn-primary\" onClick={() => setEdit({ category })}>+ New {label}</button>\n1062:         {dirty && (\n1063:           <>\n1064:             <button className=\"btn btn-primary\" onClick={saveOrder} disabled={busy} style={{ background: 'var(--coffee)', color: '#fff' }}>\n1065:               {busy ? 'Saving...' : 'Save Order'}\n1066:             </button>\n1067:             <span style={{ fontSize: 12, color: 'var(--slate-gray)' }}>Unsaved changes</span>\n1068:           </>\n1069:         )}\n1070:       </div>\n1071:       {edit && <InlineForm fields={['title', 'venue', 'location', 'start_date', 'end_date', 'description']} item={edit} onSave={handleSave} onCancel={() => setEdit(null)} busy={busy} />}\n1072:       {items.map((ex, i) => (\n1073:         <div key={ex.id} className=\"admin-list-item\" draggable={!busy}\n1074:           onDragStart={(e) => handleDragStart(e, i)}\n1075:           onDragOver={handleDragOver}\n\n(Output capped at 50 KB. Showing lines 1-1075. Use offset=1076 to continue.)\n</content>"